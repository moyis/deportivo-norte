---
import { Picture } from 'astro:assets';
import crowdImg from '../assets/hinchada.webp';
import ArrowDown from '../assets/arrow-down.svg';
import ClubAge from './ClubAge.astro';
import { CONTACT } from '../lib/contact';
---

<section class="relative min-h-screen flex items-center justify-center pt-20" aria-labelledby="hero-heading">
  <!-- Imagen de fondo optimizada con Picture -->
  <div class="hero-media absolute inset-0 z-0">
    <Picture
      src={crowdImg}
      alt="Hinchada de fútbol celebrando en un estadio"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 768, 1024, 1280, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover"
      pictureAttributes={{
        class: "absolute inset-0"
      }}
    />
    <!-- Degradado: deja ver a la hinchada arriba, ~80% en toda la zona de texto -->
    <div class="hero-overlay absolute inset-0 z-10"></div>
  </div>

  <!-- Contenido del Hero -->
  <div class="container relative z-20 text-center py-20">
    <div class="max-w-4xl mx-auto">
      <!-- Badge -->
      <p class="inline-block bg-primary text-black font-heading font-bold text-sm uppercase tracking-wider px-4 py-2 mb-6">
        Desde 1937 · Mar del Plata, Argentina
      </p>

      <!-- H1 Principal - Optimizado para SEO -->
      <h1 id="hero-heading" class="text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-heading font-bold text-white mb-6 leading-none">
        Club Deportivo Norte
      </h1>

      <!-- Subtítulo descriptivo para SEO -->
      <p class="text-xl md:text-2xl text-gray-200 mb-8 max-w-3xl mx-auto leading-relaxed text-pretty">
        Club de fútbol del barrio La Perla, <strong class="text-primary">Mar del Plata</strong>, desde 1937.
        Bicampeón de la Liga Marplatense y casa de <strong class="text-primary">"La 90"</strong>, nuestra hinchada.
      </p>

      <!-- Call to Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href={CONTACT.forms.membership} target="_blank" rel="noopener noreferrer" class="btn-primary text-lg px-8 py-4 w-full sm:w-auto">
          ¡Quiero Asociarme!
        </a>
        <a href="#historia" class="btn-secondary text-lg px-8 py-4 w-full sm:w-auto">
          Conocé Nuestra Historia
        </a>
      </div>

      <!-- Stats: solo lo verificable, con peso -->
      <div class="grid grid-cols-2 gap-8 mt-16 pt-8 border-t border-white/20 max-w-md mx-auto">
        <div class="text-center">
          <p class="text-5xl md:text-6xl font-heading font-bold text-primary"><ClubAge suffix="+" /></p>
          <p class="text-sm md:text-base text-gray-300 uppercase tracking-wide mt-1">Años de historia</p>
        </div>
        <div class="text-center">
          <p class="text-5xl md:text-6xl font-heading font-bold text-primary">2</p>
          <p class="text-sm md:text-base text-gray-300 uppercase tracking-wide mt-1">Títulos de Liga</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <a
    href="#asociate"
    class="scroll-cue absolute bottom-8 left-1/2 cursor-pointer text-primary z-20"
    aria-label="Scroll hacia la siguiente sección"
  >
  <ArrowDown class="w-8 h-8" aria-hidden="true" />
  </a>
</section>

<style>
  /* Placeholder cálido detrás de la imagen del hero mientras carga */
  .hero-media {
    background-color: #2a2a1a;
  }

  /* Degradado: deja ver a la hinchada arriba, ~80% en la zona de texto */
  .hero-overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.8) 32%,
      rgba(0, 0, 0, 0.86) 100%
    );
  }

  /* Indicador de scroll: flotación suave (ease-in-out, sin rebote) */
  .scroll-cue {
    transform: translateX(-50%);
    animation: scroll-cue 2.4s ease-in-out infinite;
  }

  @keyframes scroll-cue {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 0.4rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
    }
  }
</style>
