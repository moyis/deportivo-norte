# Token secreto que viaja en el link de la convocatoria
UPLOAD_TOKEN=reemplazame-por-un-token-largo-y-aleatorio

# Fecha y hora límite para recibir fotos (ISO 8601 en UTC)
UPLOAD_UNTIL=2026-11-01T00:00:00Z

# ID de la cuenta de Cloudflare R2
R2_ACCOUNT_ID=00000000000000000000000000000000

# Access key ID de R2
R2_ACCESS_KEY_ID=reemplazame

# Secret access key de R2
R2_SECRET_ACCESS_KEY=reemplazame

# Bucket de R2 donde llegan las fotos
R2_BUCKET=deportivo-norte-photos

# Prefijo (carpeta) dentro del bucket
R2_PREFIX=photos/
