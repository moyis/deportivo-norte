---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Asociate from '../components/Asociate.astro';
import Historia from '../components/Historia.astro';
import Videos from '../components/Videos.astro';
import FAQ from '../components/FAQ.astro';
// import Sponsors from '../components/Sponsors.astro';
import Footer from '../components/Footer.astro';
import { fetchLatestVideos } from '../lib/youtube';

import '../styles/global.css';

const seoTitle = "Club Deportivo Norte | Fútbol en Mar del Plata - Asociate";
const seoDescription = "⚽ Club Deportivo Norte - Fútbol en Mar del Plata desde 1937. Bicampeón Liga Marplatense 87-88. Asociate ahora y sé parte de la familia norteña. Estadio Carlos H. Miori, RP2 km 393.";

// Fetch videos for structured data
const videos = await fetchLatestVideos();
---

<Layout
  title={seoTitle}
  description={seoDescription}
  includeFAQ={true}
  includeVideos={videos.length > 0}
  videos={videos}
>
  <Navbar />
  
  <main id="main-content">
    <Hero />
    <Asociate />
    <Historia />
    <Videos server:defer />
    <FAQ />
    <!-- <Sponsors /> -->
  </main>
  
  <Footer />
</Layout>
