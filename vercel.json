{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "headers": [
    {
      "source": "/api/youtube-videos.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
