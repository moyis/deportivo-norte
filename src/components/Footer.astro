---
import logo from '../assets/logo.svg';
import Instagram from '../assets/instagram.svg';
import Facebook from '../assets/facebook.svg';
import YouTube from '../assets/youtube.svg';
import Email from '../assets/email.svg';
import WhatsApp from '../assets/whatsapp.svg';
import GPS from '../assets/gps.svg';
import { CONTACT } from '../lib/contact';
import { Image } from 'astro:assets';

const sections = [
  { label: 'Asociate', href: '#asociate' },
  { label: 'Historia del Club', href: '#historia' },
  { label: 'Preguntas Frecuentes', href: '#faq' },
  // { label: 'Sponsors', href: '#sponsors' },
];

const socialLinks = [
  { label: 'Instagram', href: CONTACT.social.instagram, icon: 'instagram' },
  { label: 'Facebook', href: CONTACT.social.facebook, icon: 'facebook' },
  { label: 'YouTube', href: CONTACT.social.youtube, icon: 'youtube' },
  { label: CONTACT.email, href: `mailto:${CONTACT.email}`, icon: 'email' },
  { label: CONTACT.phone.display, href: CONTACT.phone.whatsapp, icon: 'whatsapp' },
];
---

<footer id="contacto" class="bg-black border-t border-white/10 py-16" role="contentinfo">
  <div class="container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <div class="lg:col-span-2">
        <a href="#" class="flex items-center gap-3 mb-6" aria-label="Volver al inicio">
          <Image src={logo} alt="Escudo Club Deportivo Norte" class="h-12 w-auto" />
          <div>
            <span class="font-heading text-primary text-2xl font-bold uppercase block">Deportivo Norte</span>
            <span class="text-gray-400 text-sm">Desde 1937</span>
          </div>
        </a>
        <p class="text-gray-400 leading-relaxed mb-6 max-w-md">
          El Club Deportivo Norte es una institución social y deportiva de fútbol fundada en 1937 en Mar del Plata,
          Argentina. Bicampeón de la Liga Marplatense de Fútbol 1987-88.
        </p>
        <address class="not-italic text-gray-400 space-y-2">
          <p class="flex items-start gap-3">
            <GPS class="w-5 h-5 text-primary shrink-0 mt-0.5" aria-hidden="true" />
            <span>{CONTACT.location.name}<br />{CONTACT.location.address}</span>
          </p>
        </address>
      </div>

      <nav aria-label="Enlaces del pie de página">
        <h3 class="font-heading font-bold text-white uppercase text-lg mb-6">Enlaces</h3>
        <ul class="space-y-3" role="list">
          {sections.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-primary transition-colors inline-block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="font-heading font-bold text-white uppercase text-lg mb-6">Seguinos</h3>
        <ul class="space-y-3" role="list">
          {socialLinks.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-text-primary transition-colors inline-flex items-center gap-2">
                {social.icon === 'instagram' && <Instagram class="w-5 h-5" aria-hidden="true" />}
                {social.icon === 'facebook' && <Facebook class="w-5 h-5" aria-hidden="true" />}
                {social.icon === 'youtube' && <YouTube class="w-5 h-5" aria-hidden="true" />}
                {social.icon === 'email' && <Email class="w-5 h-5" aria-hidden="true" />}
                {social.icon === 'whatsapp' && <WhatsApp class="w-5 h-5" aria-hidden="true" />}
                {social.label}
              </a>
            </li>
          ))}
        </ul>
        <a href={CONTACT.forms.membership} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8 w-full text-center">¡Asociate Ahora!</a>
      </div>
    </div>
  </div>
</footer>
