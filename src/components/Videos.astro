---
import { YouTube } from 'astro-embed';
import { CONTACT } from '../lib/contact';
import { fetchLatestVideos } from '../lib/youtube';

// Server Island: renders server-side with caching
// Rest of the page remains static for optimal performance
export const server = 'defer';

// Fetch videos from YouTube RSS feed
// Cached by Vercel for 24 hours
const videos = await fetchLatestVideos();
---

<section id="videos" class="section bg-linear-to-br from-primary to-primary-dark" aria-labelledby="videos-heading">
  <div class="container">
    <header class="text-center mb-16">
      <span class="inline-block text-black font-heading font-bold text-sm uppercase tracking-widest mb-4">
        Mirá nuestros videos
      </span>
      <h2 id="videos-heading" class="text-4xl md:text-5xl font-heading font-bold text-black mb-6">
        Últimos Videos
      </h2>
      <p class="text-lg text-black/80 max-w-2xl mx-auto">
        Seguí todas las novedades del Club Deportivo Norte. Partidos, entrenamientos y momentos únicos de nuestra familia norteña.
      </p>
    </header>

    {videos.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {videos.map((video) => (
          <article class="bg-black border-4 border-primary overflow-hidden hover:border-primary/80 transition-colors duration-300">
            <YouTube id={video.id} params="color=white&modestbranding=1" />
            <div class="p-6 bg-black">
              <h3 class="text-lg font-heading font-bold text-primary">{video.title}</h3>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-400 text-lg">
          Visitá nuestro canal de YouTube para ver todos nuestros videos.
        </p>
      </div>
    )}

    <div class="text-center mt-12">
      <a
        href={CONTACT.social.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary-dark"
      >
        Ver Todos los Videos
      </a>
    </div>
  </div>
</section>
