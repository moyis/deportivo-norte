---
import { Image } from 'astro:assets';
import historyImg from '../assets/historia.webp';
import ChevronLeft from '../assets/chevron-left.svg';
import ChevronRight from '../assets/chevron-right.svg';
import ClubAge from './ClubAge';

const quotes = [
  {
    text: "Es el club de mi infancia, de mi familia, de las épocas lindas. Deportivo Norte es el club del comienzo de mi carrera deportiva. Mi agradecimiento infinito.",
    author: "Nora Alicia Vega",
    role: "5 veces campeona mundial de patín"
  },
  {
    text: "Deportivo Norte no es solo un club, es una familia. Es el lugar donde crecí, donde hice amigos para toda la vida y donde aprendí lo que significa defender una camiseta.",
    author: "Gustavo Moya",
    role: "hincha desde 1969"
  },
  {
    text: "Deportivo Norte es mi refugio, es mi lugar en el mundo. Es mi casa, lo vivo con mucha pasión. Es lo que hace que mi vida tenga sentido.",
    author: "Lucas Sarnachiaro",
    role: "ex jugador, actual miembro de Comisión Directiva"
  },
  {
    text: "Pasado, el presente y el futuro se abrazan en cada recuerdo y cada ilusión. 💛🖤",
    author: "Sergio Miori",
    role: "ex presidente de la institución"
  }
];
---

<section id="historia" class="section bg-black" aria-labelledby="historia-heading">
  <div class="container">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Contenido textual -->
      <div class="order-2 lg:order-1">
        <header class="mb-8">
          <span class="inline-block text-primary font-heading font-bold text-sm uppercase tracking-widest mb-4">
            Nuestra Historia
          </span>
          <h2 id="historia-heading" class="text-4xl md:text-5xl font-heading font-bold text-white mb-6">
            Más de <ClubAge client:load /> Años de Pasión por el Fútbol en Mar del Plata
          </h2>
        </header>

        <div class="space-y-6 text-gray-300 text-lg leading-relaxed">
          <div>
            <h3 class="text-xl font-heading font-bold text-primary mb-3">Fundación y Primeros Años</h3>
            <p>
              El <strong class="text-white">Club Deportivo Norte</strong> fue fundado el
              <strong class="text-primary">1 de abril de 1937</strong> en Mar del Plata, Argentina.
              Desde sus inicios, el club de fútbol se convirtió en el corazón del barrio La Perla,
              un punto de encuentro para vecinos y vecinas, familias marplatenses que compartían la pasión por el deporte.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-heading font-bold text-primary mb-3">Época de Oro: Bicampeonato 87-88</h3>
            <p>
              El momento de mayor gloria del fútbol marplatense llegó en los años '80, cuando el Deportivo Norte conquistó el
              <strong class="text-primary">bicampeonato de la Liga Marplatense de Fútbol en 1987 y 1988</strong>,
              consolidándose como uno de los clubes de fútbol más importantes de Mar del Plata.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-heading font-bold text-primary mb-3">Gloria Deportiva: Nora Alicia Vega</h3>
            <p>
              De nuestras filas surgió <strong class="text-white">Nora Alicia Vega</strong>,
              quien se convirtió en la <strong class="text-primary">mejor patinadora de la historia argentina</strong>:
              cinco veces campeona mundial y ganadora del Premio Olimpia de Oro en 1995.
              Nuestro predio deportivo lleva orgullosamente su nombre.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-heading font-bold text-primary mb-3">Presente: La 90 y el Estadio Miori</h3>
            <p>
              Hoy, nuestros equipos de fútbol masculino y femenino juegan de local en el <strong class="text-white">Estadio Carlos H. Miori</strong>.
              La hinchada, conocida como <strong class="text-primary">"La 90"</strong>,
              acompaña a los equipos con fidelidad y pasión en cada partido.
            </p>
          </div>

          <!-- Call to action interno -->
          <p class="text-gray-400 mt-6">
            ¿Querés ser parte de esta historia? <a href="#asociate" class="text-primary underline hover:no-underline">Asociate ahora</a> y viví la pasión de Deportivo Norte.
            También podés <a href="#videos" class="text-primary underline hover:no-underline">ver nuestros últimos videos</a> en YouTube.
          </p>
        </div>
      </div>

      <!-- Imagen/Visual y Destacados -->
      <div class="order-1 lg:order-2 space-y-8">
        <figure class="relative">
          <div class="aspect-4/5 bg-gray-dark overflow-hidden">
            <Image
              src={historyImg}
              alt="Dos camisetas del Club Deportivo Norte: pasado y presente"
              class="w-full h-full object-cover opacity-90"
              loading="lazy"
              layout="full-width"
            />
          </div>
          <!-- Badge decorativo -->
          <div class="absolute -bottom-6 -left-6 bg-primary p-6 md:p-8">
            <p class="font-heading font-bold text-black text-4xl md:text-5xl"><ClubAge client:load suffix="+" /></p>
            <p class="font-heading font-bold text-black/70 text-sm uppercase">Años de Historia</p>
          </div>
        </figure>

        <!-- Destacados -->
        <div class="grid grid-cols-2 gap-6 mt-16 pt-8 border-t border-white/10">
          <div>
            <p class="text-3xl font-heading font-bold text-primary">1937</p>
            <p class="text-gray-400 text-sm uppercase tracking-wide">Año de Fundación</p>
          </div>
          <div>
            <p class="text-3xl font-heading font-bold text-primary">2</p>
            <p class="text-gray-400 text-sm uppercase tracking-wide">Títulos Anuales LMF</p>
          </div>
          <div>
            <p class="text-3xl font-heading font-bold text-primary">"La 90"</p>
            <p class="text-gray-400 text-sm uppercase tracking-wide">Nuestra Hinchada</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Carrusel de citas destacadas -->
    <div class="mt-20 pt-12 border-t border-white/10">
      <div class="quotes-carousel relative overflow-hidden">
        <!-- Flecha izquierda -->
        <button 
          class="quote-arrow quote-prev absolute left-0 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center text-white/50 hover:text-primary transition-colors duration-300"
          aria-label="Cita anterior"
        >
          <ChevronLeft class="w-8 h-8" aria-hidden="true" />
        </button>

        <!-- Flecha derecha -->
        <button 
          class="quote-arrow quote-next absolute right-0 top-1/2 -translate-y-1/2 z-10 w-12 h-12 flex items-center justify-center text-white/50 hover:text-primary transition-colors duration-300"
          aria-label="Cita siguiente"
        >
          <ChevronRight class="w-8 h-8" aria-hidden="true" />
        </button>

        <div class="quotes-track flex transition-transform duration-700 ease-in-out">
          {quotes.map((quote) => (
            <blockquote class="quote-slide w-full shrink-0 text-center px-4">
              <p class="text-2xl md:text-3xl font-heading font-bold text-white italic max-w-4xl mx-auto">
                "{quote.text}"
              </p>
              <footer class="mt-6">
                <cite class="text-primary font-heading uppercase not-italic">— {quote.author}, {quote.role}</cite>
              </footer>
            </blockquote>
          ))}
        </div>

        <!-- Indicadores -->
        <div class="flex justify-center gap-3 mt-8">
          {quotes.map((_, index) => (
            <button 
              class="quote-dot w-3 h-3 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/50" 
              data-index={index} 
              aria-label={`Ver cita ${index + 1}`}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.querySelector('.quotes-carousel') as HTMLElement;
    const track = document.querySelector('.quotes-track') as HTMLElement;
    const dots = document.querySelectorAll('.quote-dot');
    const prevBtn = document.querySelector('.quote-prev');
    const nextBtn = document.querySelector('.quote-next');
    const totalSlides = document.querySelectorAll('.quote-slide').length;
    let currentSlide = 0;
    let autoplayInterval: ReturnType<typeof setInterval>;
    let isPaused = false;

    function goToSlide(index: number) {
      currentSlide = index;
      if (track) {
        track.style.transform = `translateX(-${currentSlide * 100}%)`;
      }
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-[var(--color-primary)]', i === currentSlide);
        dot.classList.toggle('bg-white/30', i !== currentSlide);
      });
    }

    function nextSlide() {
      goToSlide((currentSlide + 1) % totalSlides);
    }

    function prevSlide() {
      goToSlide((currentSlide - 1 + totalSlides) % totalSlides);
    }

    function startAutoplay() {
      autoplayInterval = setInterval(nextSlide, 5000);
    }

    function stopAutoplay() {
      clearInterval(autoplayInterval);
    }

    function resetAutoplay() {
      stopAutoplay();
      if (!isPaused) {
        startAutoplay();
      }
    }

    // Pausar al hacer hover
    carousel?.addEventListener('mouseenter', () => {
      isPaused = true;
      stopAutoplay();
    });

    carousel?.addEventListener('mouseleave', () => {
      isPaused = false;
      startAutoplay();
    });

    // Click en indicadores
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0');
        goToSlide(index);
        resetAutoplay();
      });
    });

    // Click en flechas
    prevBtn?.addEventListener('click', () => {
      prevSlide();
      resetAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      resetAutoplay();
    });

    // Inicializar
    goToSlide(0);
    startAutoplay();
  });
</script>
